# attendance.py

def mark_attendance(student, date, status):
    student.attendance[date] = status
    print("Attendance recorded successfully.")


def calculate_attendance_percentage(student):
    if len(student.attendance) == 0:
        return 0

    attended = 0

    for status in student.attendance.values():
        if status == "Present":
            attended += 1

    return (attended / len(student.attendance)) * 100


def display_attendance(student):
    print("\n--- Attendance Information ---")

    for date, status in student.attendance.items():
        print(date, ":", status)

    percentage = calculate_attendance_percentage(student)
    print("Attendance Percentage:", f"{percentage:.2f}%")
